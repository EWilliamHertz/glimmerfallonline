# Copy to .env and configure your PostgreSQL connection string (e.g. Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# GlimmerFallTCG.com PostgreSQL connection string for cards, deck lists, and 1v1 matches
TCG_DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
PORT=3001
# Optional shared SSO secret with glimmerfalltcg.com
GLIMMERFALL_SSO_SECRET=""
# Hidden /admin portal password for generating Founder serial keys
ADMIN_PASSWORD="your_admin_password"

# --- Client build-time (set in Vercel > Settings > Environment Variables) ---
# URL of the always-on WebSocket game server (Render etc.). Leave empty to use the same origin.
# Localhost does NOT need this: Vite proxies /api and /ws to 127.0.0.1:3001.
# VITE_GAME_SERVER_URL=https://glimmerfallonline-eem4.onrender.com
