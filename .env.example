# Copy to .env and configure your PostgreSQL connection string (e.g. Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=3001
# Optional shared SSO secret with glimmerfalltcg.com
GLIMMERFALL_SSO_SECRET=""

# --- Client build-time (set in Vercel > Settings > Environment Variables) ---
# URL of the always-on WebSocket game server (Render etc.). Leave empty to use the same origin.
# VITE_GAME_SERVER_URL=https://glimmerfall-online.onrender.com
