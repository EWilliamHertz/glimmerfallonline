{
  "name": "glimmerfall-online",
  "version": "1.1.0",
  "description": "GlimmerFall Online - 2D Pixel Art MMORPG (Authoritative 20Hz Server + Web Client)",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "dev": "vite --host 0.0.0.0 --port 8080",
    "dev:mmo": "node server/index.js & vite --host 0.0.0.0 --port 8080",
    "start": "PORT=8080 node server/index.js",
    "tunnel": "ngrok http 8080 --host-header=rewrite",
    "test": "node --test test",
    "build": "vite build && (cd landing && ([ -f node_modules/.bin/next ] || npm install) && npm run build) && rm -rf dist/landing && mkdir -p dist/landing && cp -r landing/out/* dist/landing/ && rm -rf dist/_next && mkdir -p dist/_next && cp -r landing/out/_next/* dist/_next/",
    "build:client": "vite build",
    "build:landing": "cd landing && npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "generate:assets": "node scripts/generate-meshy-assets.mjs",
    "generate:assets:check": "node scripts/generate-meshy-assets.mjs --check",
    "generate:assets:dry-run": "node scripts/generate-meshy-assets.mjs --dry-run",
    "generate:assets:list": "node scripts/generate-meshy-assets.mjs --list",
    "carbon": "node scripts/carbon.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.2.3",
    "pg": "^8.23.1",
    "three": "^0.165.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "vite": "^5.2.0"
  }
}
