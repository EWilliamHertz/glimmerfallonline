{
  "name": "glimmerfall-online",
  "version": "1.0.0",
  "description": "GlimmerFall Online - 3D MMORPG Web Client & Asset Pipeline",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "generate:assets": "node scripts/generate-meshy-assets.mjs",
    "generate:assets:check": "node scripts/generate-meshy-assets.mjs --check",
    "generate:assets:dry-run": "node scripts/generate-meshy-assets.mjs --dry-run",
    "generate:assets:list": "node scripts/generate-meshy-assets.mjs --list"
  },
  "dependencies": {
    "@fal-ai/client": "^1.2.3",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "vite": "^5.2.0"
  }
}
